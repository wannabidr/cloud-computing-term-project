# Copy this file to .env before running docker compose:
#   cp .env.example .env
#
# For the local demo, OPENAI_API_KEY may be left empty because the gateway can
# route to the mock LLM. Put a real key here only when using OpenAI directly.

# OpenAI-compatible backend
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-5.4-mini

# Gateway server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
LOG_LEVEL=info
TENANTS_FILE=/app/tenants.yaml
LOGS_DIR=/app/logs
WORKSPACE_ROOT=/workspaces

# Backend mode: auto, mock, openai, or openclaw
BACKEND_MODE=auto

# Mock LLM service used by the local docker-compose demo
MOCK_LLM_HOST=0.0.0.0
MOCK_LLM_PORT=9001
MOCK_LLM_BASE_URL=http://mock-llm:9001/v1

# OpenClaw gateway integration
OPENCLAW_BASE_URL=http://openclaw:18789
OPENCLAW_TOKEN=internal-aaas-to-openclaw-token-change-me
OPENCLAW_TIMEOUT_MS=120000
OPENCLAW_WORKSPACE_ROOT=/workspaces
OPENCLAW_AAAS_TOOLS_LOG_FILE=/app/logs/openclaw-tools.jsonl
OPENCLAW_GATEWAY_TOKEN=internal-aaas-to-openclaw-token-change-me

# Dashboard VM status endpoint
AZURE_VM_HOST=20.41.117.124
AZURE_VM_PORT=22
